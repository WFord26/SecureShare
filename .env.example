# ── Entra ID (register app at portal.azure.cn for Azure China / 21Vianet) ──────
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Authority host
# Global Azure:       https://login.microsoftonline.com
# Azure China (21Vianet): https://login.partner.microsoftonline.cn
AUTHORITY_HOST=https://login.partner.microsoftonline.cn

# ── Azure Blob Storage ──────────────────────────────────────────────────────────
STORAGE_ACCOUNT=your-storage-account-name
STORAGE_CONTAINER=uploads

# ── App ─────────────────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). Must match the redirect URI on the app registration.
BASE_URL=http://localhost:3000

# Cryptographically random string; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

PORT=3000
MAX_UPLOAD_MB=100
LINK_TTL_DAYS=7
