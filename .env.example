# ---- Entra ID app registration (see README) ----
# Default: global / US commercial cloud. Register the app at https://portal.azure.com
AUTHORITY_HOST=https://login.microsoftonline.com
# Single tenant: your tenant ID (GUID). Multi tenant: "organizations" + ALLOWED_TENANT_IDS below.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your_client_secret
# Only used when TENANT_ID=organizations. Comma separated tenant IDs allowed to sign in.
ALLOWED_TENANT_IDS=

# Azure China (21Vianet) tenant instead: register at https://portal.azure.cn and use
# AUTHORITY_HOST=https://login.partner.microsoftonline.cn
# Azure US Government: AUTHORITY_HOST=https://login.microsoftonline.us

# Public base URL of this app (no trailing slash). Redirect URI = BASE_URL/auth/callback
BASE_URL=http://localhost:3000

# ---- Azure Storage (commercial Azure subscription) ----
STORAGE_ACCOUNT=yourstorageaccount
STORAGE_CONTAINER=uploads
# Leave empty to use DefaultAzureCredential (managed identity in Azure, az login locally)
STORAGE_CONNECTION_STRING=
# Only change if the storage account is not in the global cloud (China: core.chinacloudapi.cn)
# STORAGE_ENDPOINT_SUFFIX=core.windows.net

# ---- App settings ----
# At least 32 random characters, e.g.: openssl rand -base64 48
SESSION_SECRET=generate_a_long_random_string
PORT=3000
MAX_UPLOAD_MB=100
# Uploads are buffered in memory; worst case memory is MAX_CONCURRENT_UPLOADS * MAX_UPLOAD_MB
MAX_CONCURRENT_UPLOADS=4
LINK_TTL_DAYS=7
# required (default): never serve without a clean Defender verdict. Unscannable files, scan errors and
#                     uploads after the monthly scan cap are never served.
# best-effort:        serve SCAN_GRACE_MINUTES after upload even without a verdict (malware still blocked,
#                     but unscanned files are served). Not recommended for production.
SCAN_POLICY=required
SCAN_GRACE_MINUTES=2

# ---- Activity log (Azure Table Storage, same storage account) ----
# Needs Storage Table Data Contributor for your identity, or STORAGE_CONNECTION_STRING
AUDIT_RETENTION_DAYS=730
# App role value on the app registration that opens /admin
AUDIT_ROLE=Audit.Read
