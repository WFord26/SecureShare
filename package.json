{
  "name": "secureshare",
  "version": "1.1.0",
  "description": "Authenticated file upload with anonymized 7 day download links, Defender malware scanning, Azure Blob Storage",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "bump": "node scripts/bump-version.mjs",
    "bump:patch": "npm run bump -- patch",
    "bump:minor": "npm run bump -- minor",
    "bump:major": "npm run bump -- major",
    "bump:dry": "npm run bump -- --dry-run",
    "bump:tag": "node scripts/bump-version.mjs --tag",
    "test": "npm run test:bump",
    "test:bump": "node --test scripts/bump-version.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.5.0",
    "@azure/msal-node": "^6.0.1",
    "@azure/storage-blob": "^12.26.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
