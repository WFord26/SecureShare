# Copy to infra/deploy.env and fill in. Read by infra/deploy.ps1 (PowerShell 7) and infra/deploy.sh (bash).
# Never commit deploy.env: the scripts write generated secrets back into it.

# ---- Azure target ----
SUBSCRIPTION=                      # subscription name or ID; empty = current az default
RG=rg-secureshare
LOCATION=westus3
BASE_NAME=secureshare              # prefix for derived resource names
APP_SERVICE_SKU=B1                 # F1, B1, B2, B3, S1, P0v3, P1v3
NODE_VERSION=24-lts                # az webapp list-runtimes --os linux
# Adopting an existing deployment: name the resources and the template updates them in place
APP_SERVICE_PLAN=                  # existing plan name; empty = asp-<BASE_NAME>
STORAGE_LOCATION=                  # only if the storage account is in a different region than LOCATION
APP_LOCATION=                      # only if the plan/web app are in a different region than LOCATION

# ---- Entra app registration and enterprise application (README: Deployment) ----
AUTHORITY_HOST=https://login.microsoftonline.com
TENANT_ID=00000000-0000-0000-0000-000000000000   # or "organizations" with ALLOWED_TENANT_IDS
ALLOWED_TENANT_IDS=

# true: the script manages the app registration and enterprise application. Needs the az CLI logged into the
# tenant that owns the registration, as Cloud Application Administrator (or Application Administrator) or higher.
#   deploy.ps1: everything below (create registration and secret, app roles, redirect URIs, assignments, consent)
#   deploy.sh:  redirect URIs, the AUDIT_ROLE app role and AUDIT_USERS assignments only
UPDATE_APP_REG=true
# Empty CLIENT_ID: deploy.ps1 uses the registration named APP_REG_NAME, or creates it, and saves the ID here
CLIENT_ID=
APP_REG_NAME=SecureShare
# Empty CLIENT_SECRET: deploy.ps1 creates a secret valid CLIENT_SECRET_MONTHS and saves it here.
# To rotate, clear it and run deploy.ps1 again (the old secret stays valid until you delete it in the portal).
CLIENT_SECRET=
CLIENT_SECRET_MONTHS=12

# ---- Who may sign in (deploy.ps1) ----
# true: only users and groups assigned to the enterprise application can sign in. false: everyone in the tenant,
# guests included. Empty: leave the current setting. Not turned on while nobody is assigned.
ASSIGNMENT_REQUIRED=true
# Comma separated sign in names, group names or object IDs to assign the Files.Upload role (sign in and upload).
# Assigning groups needs Microsoft Entra ID P1 or P2; nested group members are not included.
APP_USERS=
# true: grant tenant wide admin consent for the sign in permissions (openid, profile, email, offline_access),
# so nobody sees a consent prompt and tenants that block user consent still work
GRANT_ADMIN_CONSENT=true

# ---- App ----
# Leave empty to auto generate once; the scripts write the generated value back here so sessions survive redeploys
SESSION_SECRET=
# Leave empty to use the App Service default hostname; set for a custom domain (https://share.example.com)
BASE_URL=
LINK_TTL_DAYS=7
MAX_UPLOAD_MB=100
MAX_CONCURRENT_UPLOADS=4           # uploads are buffered in memory: worst case = this * MAX_UPLOAD_MB
SCAN_POLICY=required               # never serve without a clean verdict. best-effort serves unscanned files after SCAN_GRACE_MINUTES
SCAN_GRACE_MINUTES=2
SCAN_CAP_GB=500
STORAGE_CONTAINER=uploads
# Optional fixed names (otherwise derived and unique per resource group)
STORAGE_ACCOUNT=
WEB_APP_NAME=
ALLOW_SHARED_KEY_ACCESS=false
# Set false if the web app identity already has Storage Blob Data Owner on the storage account from a manual setup
CREATE_ROLE_ASSIGNMENT=true
# Same for Storage Table Data Contributor (activity log); only set false if it was already granted by hand
CREATE_TABLE_ROLE_ASSIGNMENT=true

# ---- Activity log ----
AUDIT_RETENTION_DAYS=730           # upload and download records are deleted after this many days
AUDIT_ROLE=Audit.Read              # app role that opens /admin; created on the app registration when UPDATE_APP_REG=true
# Comma separated sign in names or object IDs to assign AUDIT_ROLE to (deploy.ps1 also accepts group names).
# With ASSIGNMENT_REQUIRED=true this role also lets them sign in.
AUDIT_USERS=
